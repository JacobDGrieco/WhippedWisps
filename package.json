{
	"name": "whippedwisps",
	"private": true,
	"workspaces": [
		"server",
		"client"
	],
	"allowScripts": {
		"better-sqlite3@11.10.0": true,
		"esbuild@0.21.5": true
	},
	"scripts": {
		"dev": "concurrently --kill-others-on-fail \"npm run dev:server\" \"npm run dev:client:ready\"",
		"dev:server": "npm run dev -w server",
		"dev:client": "npm run dev -w client",
		"dev:client:ready": "node scripts/wait-for-server.js http://127.0.0.1:3001/api/health && npm run dev:client",
		"test:server": "npm run test -w server",
		"build:client": "npm run build -w client",
		"build": "npm run build:client"
	},
	"devDependencies": {
		"concurrently": "^10.0.4"
	}
}
