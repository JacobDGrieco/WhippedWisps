{
	"name": "whippedwisps",
	"private": true,
	"workspaces": [
		"server",
		"client"
	],
	"allowScripts": {
		"better-sqlite3@11.10.0": true,
		"esbuild@0.21.5": true
	},
	"scripts": {
		"dev": "concurrently --kill-others-on-fail \"npm run dev:server\" \"npm run dev:client:ready\"",
		"dev:server": "npm run dev -w server",
		"dev:client": "npm run dev -w client",
		"dev:vercel": "vercel dev",
		"test:server": "npm run test -w server",
		"build:client": "npm run build -w client",
		"build": "npm run build:client"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^4.3.4",
		"concurrently": "^10.0.4",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^6.30.1",
		"vercel": "^59.11.7",
		"vite": "^5.4.19"
	}
}
